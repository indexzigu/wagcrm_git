{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // ygrd-link 는 Cloudflare Worker 라 런타임 타입(@cloudflare/workers-types)과 lib 설정이
  // 다르다. 자체 tsconfig 로 `cd ygrd-link && npm run typecheck` 하고, 여기서는 제외한다.
  "exclude": ["node_modules", "prisma/*.ts", "scripts", "ygrd-link", "wag-heartbeat"]
}
