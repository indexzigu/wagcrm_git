{
  "name": "wag-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-sqlite-client.mjs",
    "dev": "next dev -p 3002",
    "predev:ro": "node scripts/ensure-sqlite-client.mjs",
    "dev:ro": "DB_READ_ONLY=1 next dev -p 3002",
    "predev:local": "node scripts/ensure-sqlite-client.mjs",
    "dev:local": "DATABASE_URL=file:./dev.db DIRECT_URL= NO_PROXY=localhost,127.0.0.1,192.168.36.121 no_proxy=localhost,127.0.0.1,192.168.36.121 next dev --webpack -H 127.0.0.1 -p 3002",
    "predev:demo": "node scripts/ensure-sqlite-client.mjs",
    "dev:demo": "DEMO_MODE=1 NEXT_PUBLIC_DEMO_MODE=1 DATABASE_URL=file:./demo.db DIRECT_URL= NO_PROXY=localhost,127.0.0.1,192.168.36.121 no_proxy=localhost,127.0.0.1,192.168.36.121 next dev --webpack -H 127.0.0.1 -p 3002",
    "predemo:seed": "node scripts/ensure-sqlite-client.mjs",
    "demo:seed": "DEMO_MODE=1 DATABASE_URL=file:./demo.db tsx scripts/sqlite-push.ts && DEMO_MODE=1 DATABASE_URL=file:./demo.db tsx prisma/seed-demo.ts",
    "build:demo": "prisma generate && node scripts/ensure-sqlite-client.mjs && npm run demo:seed && DEMO_MODE=1 NEXT_PUBLIC_DEMO_MODE=1 DATABASE_URL=file:./demo.db next build",
    "prebuild": "node scripts/ensure-sqlite-client.mjs",
    "build": "node scripts/prisma-migrate-on-deploy.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint src/",
    "pretypecheck": "node scripts/ensure-sqlite-client.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts",
    "typecheck:app": "tsc --noEmit",
    "pretypecheck:scripts": "node scripts/ensure-sqlite-client.mjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "design:lint": "designmd lint DESIGN.md",
    "design:export": "designmd export --format tailwind DESIGN.md",
    "test": "vitest run",
    "test:ci": "HERMETIC_ONLY=1 DATABASE_URL=file:./dev.db DIRECT_URL= vitest run",
    "pretest:e2e": "node scripts/ensure-sqlite-client.mjs",
    "test:e2e": "npx -y kill-port 3002 || true; DATABASE_URL=file:./dev.db npm run db:push && DATABASE_URL=file:./dev.db npx playwright test -c e2e/playwright.config.ts",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:selfhost": "tsx scripts/check-selfhost-env.ts",
    "data:check": "node --import tsx scripts/check-campaign-data.ts",
    "qa:smoke": "tsx scripts/smoke-crm.ts",
    "hometax:helper": "tsx scripts/hometax-helper/index.ts",
    "verify:import-health": "tsx scripts/verify-import-health.ts",
    "verify:cache-policy": "tsx scripts/verify-cache-policy.ts",
    "verify:release-config": "tsx scripts/verify-release-config.ts",
    "verify:github-secrets": "tsx scripts/verify-github-secrets.ts",
    "verify:supabase-storage": "tsx scripts/verify-supabase-storage.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "node scripts/ensure-sqlite-client.mjs && node scripts/ensure-playwright-browser.mjs",
    "playwright:ensure": "node scripts/ensure-playwright-browser.mjs",
    "guard:commit": "node scripts/commit-guard.mjs --staged",
    "release:check": "npm run env:check && npm run verify:cache-policy && npm run verify:release-config && npm run typecheck:scripts && npm run lint && npm run build",
    "board:check": "node scripts/board-drift-check.mjs",
    "db:generate": "prisma generate && DATABASE_URL=file:./dev.db prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "tsx scripts/sqlite-push.ts",
    "db:sales-task:remote:plan": "node --import tsx scripts/print-sales-task-remote-sync.ts",
    "db:sales-task:remote:sql": "node --import tsx scripts/print-sales-task-remote-sync.ts --sql",
    "db:seed:local": "DATABASE_URL=file:./dev.db DIRECT_URL= tsx prisma/seed.ts",
    "notion:triage:sellers": "tsx scripts/generate-notion-seller-triage-worksheet.ts",
    "notion:triage:review": "tsx scripts/generate-notion-review-worksheets.ts",
    "notion:triage:remaining": "node --import tsx scripts/generate-notion-remaining-manual-review.ts",
    "notion:triage:remote-status": "node --import tsx scripts/generate-notion-remote-backlog-status-report.ts",
    "notion:triage:discrepancies": "node --import tsx scripts/generate-notion-decision-discrepancy-report.ts",
    "notion:triage:decisions": "node --import tsx scripts/generate-notion-decision-templates.ts",
    "notion:triage:sync": "node --import tsx scripts/sync-notion-worksheets-to-decision-templates.ts",
    "notion:triage:autofill:seller:safe": "node --import tsx scripts/autofill-notion-seller-decisions-safe.ts",
    "notion:triage:autofill:safe": "node --import tsx scripts/autofill-notion-decisions-safe.ts",
    "notion:triage:prefill:seller": "node --import tsx scripts/prefill-notion-seller-decisions-safe.ts",
    "notion:triage:reconcile:seller": "node --import tsx scripts/reconcile-notion-seller-decisions-safe.ts",
    "notion:triage:autofill:deal:safe": "node --import tsx scripts/autofill-notion-deal-decisions-safe.ts",
    "notion:triage:prefill:deal": "node --import tsx scripts/prefill-notion-deal-decisions-safe.ts",
    "notion:triage:reconcile:deal": "node --import tsx scripts/reconcile-notion-deal-decisions-safe.ts",
    "notion:triage:plan": "node --import tsx scripts/generate-notion-decision-plan.ts",
    "notion:decision:flow": "node --import tsx scripts/run-notion-decision-flow.ts",
    "notion:decision:flow:apply:local": "node --import tsx scripts/run-notion-decision-flow.ts --apply-local",
    "notion:decision:dry-run": "node --import tsx scripts/apply-notion-decision-plan.ts --target=local",
    "notion:decision:apply:local": "node --import tsx scripts/apply-notion-decision-plan.ts --apply --target=local",
    "notion:decision:apply:remote": "node --import tsx scripts/apply-notion-decision-plan.ts --apply --target=remote",
    "notion:triage:refresh": "node --import tsx scripts/refresh-notion-review-workspace.ts",
    "kakao:ingest": "node --import tsx scripts/kakao-ingest.ts",
    "kakao:ingest:dry": "node --import tsx scripts/kakao-ingest.ts --dry-run",
    "kakao:reconcile": "node --import tsx scripts/kakao-reconcile.ts",
    "data:sales:export": "node --import tsx scripts/export-campaign-sales.ts",
    "data:sales:import": "node --import tsx scripts/import-campaign-sales.ts",
    "report:apify-comments": "node --import tsx scripts/report-apify-comment-usage.ts",
    "data:seller:mirror-images": "node --import tsx scripts/backfill-seller-profile-images.ts",
    "data:seller:mirror-images:apply": "node --import tsx scripts/backfill-seller-profile-images.ts --apply",
    "test:browser": "node test-browser-local.js",
    "agent-worker:build-native": "cd src/lib/agent-worker/native/peer-cred && node \"$(dirname \"$npm_execpath\")/../node_modules/node-gyp/bin/node-gyp.js\" rebuild"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.53.1",
    "@sparticuz/chromium": "148.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tremor/react": "^3.18.7",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "got-scraping": "^4.2.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "https-proxy-agent": "^9.1.0",
    "imap-simple": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "mailparser": "^3.9.10",
    "motion": "^12.23.12",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "officecrypto-tool": "^0.0.19",
    "p-queue": "^9.3.0",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fast-check": "^3.23.2",
    "jsdom": "^29.1.1",
    "node-addon-api": "8.8.0",
    "playwright-core": "^1.59.1",
    "prisma": "^6.19.3",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
