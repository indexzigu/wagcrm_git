generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Partner {
  id                  String           @id @default(cuid())
  name                String
  type                String
  status              String?
  contactInfo         String?
  bankAccount         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  referredById        String?
  companyRole         String?
  companyStatus       String?
  lastContactAt       DateTime?
  notes               String?
  businessNumber      String?
  address             String?
  bizSyncedAt         DateTime?
  ceoName             String?
  businessType        String?
  businessItem        String?
  representativeEmail String?
  // F4-② 딜 온보딩 제로코드화(GROWTH_FLYWHEEL_PLAN.md §F4): 발주 브랜드 설정.
  // orderTemplateSlug 값이 있으면 이 거래처는 "발주 브랜드"(OrderCampaign.template의 해석 대상).
  orderTemplateSlug   String?          @unique // 예: nutrione (OrderCampaign.template과 매칭되는 키)
  orderDisplayName    String? // 발주서/파일명/드롭다운 표시명(예: 뉴트리원). 없으면 name 사용
  orderEmailDomains   String? // 회신 발주서 허용 발신 도메인(쉼표구분, 예: @example.com)
  orderFormatAdapter  String? // (레거시) 양식 어댑터 template-file|tripp — Phase 2 매핑 엔진이 대체 예정
  orderToEmail        String? // 발주서 기본 수신 이메일(To). 값이 있으면 발주 브랜드로 등록됨
  orderCcEmail        String? // 발주서 보조 수신 이메일(CC, 선택)
  orderExcelRules     Json? // F4 Phase 2: 네이버→발주서 열 매핑 규칙(OrderExcelRules v1, excel-rules.ts zod 검증)
  deals               Deal[]
  referredBy          Partner?         @relation("PartnerReferral", fields: [referredById], references: [id])
  referrals           Partner[]        @relation("PartnerReferral")
  contacts            PartnerContact[]
  sellerAgents        Seller[]         @relation("SellerAgency")
  priceSheets         PriceSheet[]

  @@index([type])
  @@index([name])
  @@index([referredById])
}

model Seller {
  id                    String                     @id @default(cuid())
  name                  String
  snsType               String
  snsHandle             String
  currentFollowers      Int                        @default(0)
  currentPostsCount     Int?
  profileBio            String?
  profilePicUrl         String?
  profileExternalUrls   String?
  category              String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  agencyId              String?
  accountNumber         String?
  residentNumber        String?
  activityFrequency     String?
  adResponseScore       String?
  channelUrl            String?
  collaborationScore    String?
  commentResponseScore  String?
  email                 String?
  fitLevel              String?
  lastReviewedAt        DateTime?
  mailingAddress        String?
  notes                 String?
  personalCategory      String?
  phoneNumber           String?
  proposalProduct       String?
  proposalStatus        String?
  proposalWaitlist      String?
  reviewer              String?
  isMonitored           Boolean                    @default(false)
  alias                 String?
  // 원천징수 신고·간이지급명세서에 적는 법적 실명(2026-08-04). `name` 은 실무에서 활동명이
  // 들어가 있어 신고 서식에 그대로 쓸 수 없다 — 두 값을 분리해 폴백 없이 이 필드만 쓴다.
  realName              String?
  portalToken           String?                    @unique
  // 셀러 전용 주소 포털(2026-07-10): crm.ygrd.kr/<slug> + 비밀번호 게이트.
  // slug는 셀러 계정명 기반(공개 취급) — 비밀은 비밀번호(bcrypt 해시)뿐이다.
  portalSlug            String?                    @unique
  portalPasswordHash    String?
  // 무차별 대입 방어: 실패 카운트/잠금 해제 시각(서버리스에서도 살아남게 DB에 둔다)
  portalAuthFailCount   Int                        @default(0)
  portalAuthLockedUntil DateTime?
  // F6 outcome 적립(GROWTH_FLYWHEEL_PLAN.md §F6): 유입 경로·소개 계보·가용 일정 — 소급 불가 데이터라 등록 시점부터 기록
  acquisitionChannel    String? // REFERRAL | NETWORK | INBOUND | COLD | DISCOVERY
  referredById          String?
  acquisitionNote       String?
  // 가용 일정은 셀러에게 직접 확인한 값만 기록(캠페인 이력 추정 금지 — 2026-07-07 소유자 확정)
  availabilityNote      String?
  availabilityUpdatedAt DateTime?
  referredBy            Seller?                    @relation("SellerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Seller[]                   @relation("SellerReferral")
  campaigns             SalesCampaign[]
  campaignGroups        CampaignGroup[]
  storySnapshots        SellerStorySnapshot[]
  postClassifications   SellerPostClassification[]
  salesTasks            SalesTask[]
  agency                Partner?                   @relation("SellerAgency", fields: [agencyId], references: [id])
  categoryAssignments   SellerCategoryAssignment[]
  bioHistories          SellerProfileBioHistory[]
  outreaches            SellerOutreach[]
  histories             SellersHistory[]

  @@unique([snsType, snsHandle])
  @@index([category])
  @@index([agencyId])
  @@index([referredById])
}

model SellersHistory {
  id                  String   @id @default(cuid())
  sellerId            String
  snapshotDate        DateTime
  followersCount      Int
  postsCount          Int?
  profileBio          String?
  profilePicUrl       String?
  profileExternalUrls String?
  source              String   @default("INTERNAL")
  // ER 추이 (§11-3 결정: SellersHistory 재사용, 파생 스칼라만 적립 — 게시물 원본 JSON 미저장)
  // (평균 좋아요+평균 댓글)/팔로워. 팔로워-only 갱신 경로는 undefined로 넘겨 기존 값을 보존한다.
  er                  Float?
  avgLikes            Float?
  avgComments         Float?
  createdAt           DateTime @default(now())
  seller              Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, snapshotDate])
  @@index([snapshotDate])
}

model SellerProfileBioHistory {
  id          String   @id @default(cuid())
  sellerId    String
  collectedAt DateTime @default(now())
  previousBio String?
  bio         String
  source      String   @default("INTERNAL")
  createdAt   DateTime @default(now())
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, collectedAt])
}

model Deal {
  id                      String                 @id @default(cuid())
  dealName                String
  costPrice               Decimal                @default(0)
  baseMarginPolicy        String
  status                  DealStatus             @default(SOURCING)
  partnerId               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  sellingPrice            Decimal                @default(0)
  brandName               String?
  brokerageCommissionRate Decimal?
  candidateSellers        String?
  discountRate            Decimal?
  floorPrice              Decimal?
  listPrice               Decimal?
  partnerCompanyName      String?
  sourcingMemo            String?
  totalCommissionRate     Decimal?
  supplyPrice             Float?
  optionSortOrder         Int                    @default(0)
  dealType                String                 @default("MAIN")
  parentDealId            String?
  unit                    String?
  unitQuantity            Int?
  supplementaryInfo       String?
  shippingFee             Decimal?
  freeShippingThreshold   Decimal?
  monitorEnabled          Boolean                @default(true)
  // 클레임 게이트의 카테고리 규칙 선택자(FOOD|SUPPLEMENT|COSMETIC|GENERAL).
  // enum이 아니라 String — 카테고리 세트는 운영 중 늘어난다(C1 스펙 §4).
  category                String?
  claims                  DealClaim[]
  offerAnswers            DealOfferAnswer[]
  assetDrafts             DealAssetDraft[]
  guideDrafts             DealGuideDraft[]
  campaignDeals           CampaignDeal[]
  templates               CampaignTemplate[]
  parentDeal              Deal?                  @relation("DealOptions", fields: [parentDealId], references: [id])
  options                 Deal[]                 @relation("DealOptions")
  partner                 Partner?               @relation(fields: [partnerId], references: [id])
  campaigns               SalesCampaign[]
  salesTasks              SalesTask[]
  outreaches              SellerOutreach[]
  priceSheetRows          PriceSheetRow[]
  priceMonitorSnapshots   PriceMonitorSnapshot[]

  @@index([status])
  @@index([partnerId])
  @@index([parentDealId])
}

model SalesCampaign {
  id                      String                     @id @default(cuid())
  dealId                  String
  sellerId                String
  startDate               DateTime
  endDate                 DateTime
  salesChannel            String
  baseNaverLink           String
  generatedTrackingLink   String
  actualSales             Decimal?
  totalMarginRate         Decimal                    @default(0)
  sellerMarginRate        Decimal                    @default(0)
  netMarginRate           Decimal                    @default(0)
  status                  String                     @default("PROPOSAL")
  isManualMargin          Boolean                    @default(false)
  isManualSettlementSales Boolean                    @default(false)
  isManualSellerExpense   Boolean                    @default(false)
  isManualTaxExpense      Boolean                    @default(false)
  assignedTo              String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  itemCount               Int?
  nextAction              String?
  notesFromImport         String?
  operatingExpense        Decimal?
  operatingProfit         Decimal?
  quantity                Int?                       @map("orderCount")
  rawSchedule             String?
  salesCode               String?
  sellerExpense           Decimal?
  settlementSales         Decimal?
  sourceCreatedAt         DateTime?
  actualPayoutAmount      Decimal?
  commissionBasis         String?
  isDepositReceived       Boolean                    @default(false)
  isPayoutCompleted       Boolean                    @default(false)
  miscExpense             Decimal?
  roundNumber             Int?
  sellerTaxType           String?
  taxExpense              Decimal?
  depositReceivedAt       DateTime?
  payoutCompletedAt       DateTime?
  campaignName            String?
  accountingCompletedAt   DateTime?
  expectedDepositDate     DateTime?
  expectedPayoutDate      DateTime?
  /// 자사몰 전용 2번째 지급 레그(공급사 물품대금). 자사몰은 몰 정산금이 일별 입금이라 입금
  /// 일정이 없고 지급이 공급사·셀러 둘이다 — 기존 payout 3종은 셀러 지급으로 좁혀진다.
  /// 슬롯 판정 SSOT: resolveCampaignMoneySlots(tax-filing-board.ts). 단일 지급 채널은 미사용(null).
  expectedSupplierPayoutDate DateTime?
  supplierPayoutCompletedAt  DateTime?
  isSupplierPayoutCompleted  Boolean                   @default(false)
  returnPeriodEndDate     DateTime?
  sellerInvoiceIssuedAt   DateTime?
  settlementSupplyCost    Decimal?
  /// 수기 물품대금 = 이 캠페인 앞 매입 계산서 합계(VAT 포함). 세무 대조 전용 — 손익 소비 금지.
  settlementGoodsCost     Decimal?
  supplierInvoiceIssuedAt DateTime?
  shippingFee             Decimal?
  freeShippingThreshold   Decimal?
  calendarEventIds        String? // 구글 캘린더 이벤트 id (JSON: {campaign,deposit,payout}) — 멱등 동기화용
  groupId                 String? // CG-1: 조합 캠페인 묶음(CampaignGroup) 소속. null=미그룹. 멤버십 변경은 서비스 경유만.
  group                   CampaignGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assets                  Asset[]
  activities              CampaignActivity[]
  checklistItems          CampaignChecklistItem[]
  settlementItems         CampaignSettlementItem[]
  campaignDeals           CampaignDeal[]
  notes                   CampaignNote[]
  deal                    Deal                       @relation(fields: [dealId], references: [id])
  seller                  Seller                     @relation(fields: [sellerId], references: [id])
  settlementChecklist     SettlementChecklist?
  attributions            TrackingAttribution[]
  trackedLinks            TrackedLink[]
  orderCampaignId         String?
  orderCampaign           OrderCampaign?             @relation(fields: [orderCampaignId], references: [id])
  actionProposals         ActionProposal[]
  workRecords             WorkRecord[]
  chatRoomMappings        ChatRoomMapping[]
  buyerFingerprints       CampaignBuyerFingerprint[]

  // DB에는 DEFERRABLE INITIALLY DEFERRED 제약으로 생성됨(recalculateCampaignRounds의
  // 차수 재배열 중간 스왑 허용, 커밋 시점 검사) — 마이그 20260720000000 직접 실행.
  @@unique([dealId, sellerId, roundNumber])
  @@index([status])
  @@index([dealId])
  @@index([sellerId])
  @@index([startDate, endDate])
  @@index([assignedTo])
  @@index([salesCode])
  @@index([groupId])
}

// 회차간 재구매 영구 지문 — NaverOrderSnapshot 30일 보관 한계를 넘어 회차별 구매자를 보존한다.
// 스냅샷이 만료돼도 "이 회차에 누가 샀는가"(해시)만 남겨, 수개월 간격의 다음 회차에서
// 재구매(returning) 대조가 가능해진다(2026-07-11 소유자 결정, 포워드 전용·과거 소급 불가).
// buyerHash = sha256(pepper + ordererNo) — 원문 ordererNo(PII)는 절대 저장하지 않는다.
// 쓰기는 sweepBuyerFingerprints(cron naver-order-sync)만, 읽기는 회차간 재구매 집계만.
model CampaignBuyerFingerprint {
  id              String        @id @default(cuid())
  salesCampaignId String
  buyerHash       String
  createdAt       DateTime      @default(now())
  salesCampaign   SalesCampaign @relation(fields: [salesCampaignId], references: [id], onDelete: Cascade)

  @@unique([salesCampaignId, buyerHash])
  @@index([salesCampaignId])
}

// CG-1: 조합 캠페인 묶음(1개 실캠페인 = N개 관리캠페인) 그룹 엔티티.
// 순수 가산 — SalesCampaign 컬럼 삭제 없음. 전 멤버 동일 sellerId(앱 레벨 불변식).
// startDate/endDate는 멤버 min/max 롤업(표시용, SoT 아님). 정산/캘린더 필드는 CG-2/3 배선 전 미사용(null 시작).
model CampaignGroup {
  id                      String          @id @default(cuid())
  sellerId                String // 식별 앵커 — 전 멤버 동일 셀러(앱 레벨 불변식)
  name                    String? // 자동 "[셀러별칭] 대표딜명 외 N-1건"(D4), 수동 override 허용
  startDate               DateTime? // 대표 기간 롤업(멤버 min) — SoT 아님
  endDate                 DateTime? // 대표 기간 롤업(멤버 max)
  expectedDepositDate     DateTime?
  depositReceivedAt       DateTime?
  isDepositReceived       Boolean         @default(false)
  expectedPayoutDate      DateTime?
  payoutCompletedAt       DateTime?
  isPayoutCompleted       Boolean         @default(false)
  // 자사몰 공급사 지급 레그 — SalesCampaign 쪽 주석 참조. 정산일 그룹 스칼라 SoT 규약 동승.
  expectedSupplierPayoutDate DateTime?
  supplierPayoutCompletedAt  DateTime?
  isSupplierPayoutCompleted  Boolean        @default(false)
  supplierInvoiceIssuedAt DateTime?
  sellerInvoiceIssuedAt   DateTime?
  accountingCompletedAt   DateTime?
  returnPeriodEndDate     DateTime?
  invoiceInfo             String? // JSON — CG-2 배선 전 미사용
  calendarEventIds        String? // JSON {campaign,deposit,payout} — CG-3 배선 완료. 그룹 멤버는 개별 이벤트를 갖지 않고(합류 시 삭제) 이 장부가 유일 정본이다
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  seller                  Seller          @relation(fields: [sellerId], references: [id])
  members                 SalesCampaign[]

  @@index([sellerId])
  @@index([startDate, endDate])
}

model CampaignChecklistTemplate {
  id         String                  @id @default(cuid())
  status     String
  label      String
  sortOrder  Int
  isRequired Boolean                 @default(true)
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  items      CampaignChecklistItem[]

  @@unique([status, label])
  @@index([status, sortOrder])
  @@index([isActive])
}

model CampaignChecklistItem {
  id          String                     @id @default(cuid())
  campaignId  String
  templateId  String?
  status      String
  label       String
  sortOrder   Int
  isRequired  Boolean                    @default(true)
  isChecked   Boolean                    @default(false)
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  campaign    SalesCampaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template    CampaignChecklistTemplate? @relation(fields: [templateId], references: [id])

  @@index([campaignId, status, sortOrder])
  @@index([templateId])
  @@index([status, isChecked])
}

/// 캠페인 정산 부가 항목 — 「매출 × 요율」 파생 밖에서 움직이는 돈의 명세.
/// 평소 0행이 정상이다(항상 발생하는 비용이 아니다 — 해당 케이스에만 추가).
/// 설계 정본: docs/private/specs/2026-08-07-settlement-money-separation-design.md
///
/// ⛔ 셀러 정산 기준(sellerExpense 파생)에 절대 반영하지 않는다 — 불변식
///    「셀러 정산 = actualSales × 셀러수수료율」(오너 확정). 저장 파생식
///    operatingProfit 도 바꾸지 않는다(손익 반영은 표시 계층의 조정 후 손익).
///    이 두 금지는 settlement-items.contract.test.ts 가 소스 스캔으로 강제한다.
model CampaignSettlementItem {
  id String @id @default(cuid())

  campaignId String
  campaign   SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// 계산서 방식: PURCHASE_RECEIVE(매입계산서 수취 = 상대 발행·우리 지급) |
  /// SALES_ISSUE(매출계산서 발행 = 우리 발행·우리 수취) | NO_INVOICE(계산서 없음
  /// — 원천징수 대상 개인 셀러 지급, 소비자 현금 수취 등). 값 정본은
  /// src/lib/settlement-items.ts 의 SETTLEMENT_INVOICE_MODES.
  invoiceMode String

  /// 대상: BRAND | SELLER | INTERNAL(자사 손익 기록 전용). 대상이 INTERNAL 이면
  /// invoiceMode 는 NO_INVOICE 로 고정된다(상대 없는 계산서는 성립하지 않는다).
  counterparty String

  /// VAT 포함 금액 — **부호 있는 값**. 표시 부호 = (방식 기본 부호) × (이 값 부호).
  /// 평상시엔 양수를 넣고, 음수는 역방향 정정(수정세금계산서·반품 조정 차감)이다.
  /// 대상이 INTERNAL 이면 이 값의 부호가 곧 수입(+)/지출(−)이다.
  /// ⛔ 별도 방향 열거 필드를 만들지 않는다 — 부호를 두 곳에 저장하면 어긋난다.
  amount Decimal

  /// 비고 — 이 비용이 무엇인지(예: 반품배송비). 읽기 모드의 행 라벨이자
  /// 2단계에서 세금계산서 품목 행 라벨로 쓰인다.
  note String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
}

model PartnerContact {
  id            String    @id @default(cuid())
  partnerId     String
  name          String
  role          String?
  email         String?
  phoneNumber   String?
  notes         String?
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, name])
  @@index([lastContactAt])
}

model CampaignActivity {
  id         String        @id @default(cuid())
  campaignId String
  action     String
  label      String
  details    String?
  actor      String        @default("SYSTEM")
  createdAt  DateTime      @default(now())
  campaign   SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([action, createdAt])
}

model CampaignNote {
  id         String        @id @default(cuid())
  campaignId String
  content    String
  actor      String
  actorName  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  campaign   SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model Asset {
  id                  String         @id @default(cuid())
  provider            String
  section             String
  entityType          String
  entityId            String
  campaignId          String?
  fileName            String
  mimeType            String?
  sizeBytes           Int            @default(0)
  storagePath         String?
  externalFileId      String?
  externalUrl         String?
  thumbnailUrl        String?
  notes               String?
  // 게시물 반응 지표 — 캠페인 셀러 게시물(EXTERNAL_LINK)에만 크론(campaign-engagement-collector)이 채운다.
  // 3-state 규약: null=미집계 · 숫자=집계값 · likesHidden=true면 좋아요 숨김(임의 숫자 저장 금지, likeCount는 null 유지).
  likeCount           Int?
  commentCount        Int?
  likesHidden         Boolean?
  engagementSyncedAt  DateTime? // 지표 최종 수집 시각 — 크론 staleness 게이트·화면 기준시점 표기용
  // 표현 자산 — 같은 Tier0 응답에서 함께 적재(추가 호출 0). 유형 배지·롤오버 재생의 데이터 계약.
  mediaType           String? // normalizeMediaType 값(image/video/reel/carousel/unknown)
  videoUrl            String? // 릴스/영상 원본 mp4(fbcdn 서명 URL=만료성 — 활성 창 동안 크론이 매일 갱신)
  postedAt            DateTime? // 게시 시각(taken_at)
  uploadedBy          String?
  archivedAt          DateTime?
  driveShortcutId     String? // 구글 드라이브 바로가기 파일 ID (바로가기 레코드에만 존재)
  driveParentFolderId String? // 바로가기가 위치한 구글 드라이브 폴더 ID
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  campaign            SalesCampaign? @relation(fields: [campaignId], references: [id])

  // H1: 부분 유니크 인덱스 "Asset_entity_externalUrl_active_key"가 DB에 존재한다 —
  // (entityType, entityId, externalUrl) WHERE archivedAt IS NULL AND externalUrl IS NOT NULL.
  // Prisma가 부분 인덱스를 미지원하므로 raw SQL 마이그레이션
  // (20260721000000_add_asset_active_external_url_unique)에서만 정의(선례: SellerAiProfile FK).
  // 위반 시 P2002 — assets POST · reference-inbox assign · promote-content가 재조회 후
  // alreadyExists로 폴백한다. 보관(archivedAt) 후 같은 링크 재등록은 허용된다.
  @@index([entityType, entityId])
  @@index([campaignId])
  @@index([provider])
  @@index([section])
  @@index([archivedAt])
  @@index([createdAt])
}

